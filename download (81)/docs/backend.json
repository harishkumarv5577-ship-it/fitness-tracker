        },
        "timestamp": {
          "type": "string",
          "description": "Date and time when the meal was logged.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userProfileId",
        "mealType",
        "foodName",
        "calories",
        "protein",
        "timestamp"
