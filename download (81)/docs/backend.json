        "calories": {
          "type": "number",
          "description": "Estimated calories."
        },
        "protein": {
            "type": "number",
            "description": "Estimated protein in grams."
        },
        "photoUrl": {
          "type": "string",
          "description": "URL of an uploaded photo of the meal.",
