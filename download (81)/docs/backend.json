      "description": "Represents a fitness activity logged by a user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the FitnessActivity entity."
        },
        "userProfileId": {
          "type": "string",
          "description": "Reference to UserProfile. (Relationship: UserProfile 1:N FitnessActivity)"
        },
        "type": {
          "type": "string",
          "description": "Type of activity (e.g., Running, Swimming, Cycling, Workout)."
        },
        "duration": {
          "type": "number",
          "description": "Duration of the activity in minutes."
        },
        "distance": {
          "type": "number",
          "description": "Distance covered during the activity in kilometers."
        },
        "calories": {
          "type": "number",
          "description": "Number of calories burned during the activity."
        },
        "steps": {
          "type": "number",
          "description": "Number of steps taken during the activity."
        },
        "heartRate": {
          "type": "number",
          "description": "Average heart rate in beats per minute."
        },
        "timestamp": {
          "type": "string",
          "description": "Date and time when the activity was logged.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userProfileId",
        "type",
        "duration",
        "calories",
        "timestamp"
      ]
