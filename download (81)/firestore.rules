/**
 * @fileoverview Firestore Security Rules for the FitApp application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has complete control over their profile data,
 * fitness activities, food logs, BMI records, and goals. No data can be accessed or modified by other users or unauthenticated clients.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, which represents the individual user's data tree.
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/fitnessActivities/{fitnessActivityId}: Stores fitness activity records.
 * - /users/{userId}/foodLogs/{foodLogId}: Stores food log records.
 * - /users/{userId}/bmiRecords/{bmiRecordId}: Stores BMI records.
 * - /users/{userId}/goals/{goalId}: Stores fitness goals.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied to prevent unauthorized access to user IDs.
 * - All write operations are restricted to the authenticated user, ensuring data privacy and integrity.
 * - The rules leverage path-based authorization, eliminating the need for costly `get()` calls to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID and the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user IDs match and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile: auth.uid == 'user123'
     * @deny (create) User with ID 'user123' cannot create a profile for 'user456': auth.uid != 'user123'
     * @allow (get) User with ID 'user123' can read their profile: auth.uid == 'user123'
     * @deny (get) User with ID 'user123' cannot read the profile of 'user456': auth.uid != 'user123'
     * @allow (update) User with ID 'user123' can update their profile: auth.uid == 'user123'
     * @deny (update) User with ID 'user123' cannot update the profile of 'user456': auth.uid != 'user123'
     * @allow (delete) User with ID 'user123' can delete their profile: auth.uid == 'user123'
     * @deny (delete) User with ID 'user123' cannot delete the profile of 'user456': auth.uid != 'user123'
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Prevent listing all users
      allow list: if false;

      // Only the user can create their own profile.
      allow create: if isOwner(userId) && request.resource.data.id == userId;

      // Only the user can read their own profile.
      allow get: if isOwner(userId);

      // Only the user can update their own profile.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Only the user can delete their own profile.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/fitnessActivities/{fitnessActivityId} collection.
     * @path /users/{userId}/fitnessActivities/{fitnessActivityId}
     * @allow (create) User with ID 'user123' can create a fitness activity record under their profile.
     * @deny (create) User with ID 'user123' cannot create a fitness activity record under the profile of 'user456'.
     * @allow (get) User with ID 'user123' can read a fitness activity record under their profile.
     * @deny (get) User with ID 'user123' cannot read a fitness activity record under the profile of 'user456'.
     * @allow (update) User with ID 'user123' can update a fitness activity record under their profile.
     * @deny (update) User with ID 'user123' cannot update a fitness activity record under the profile of 'user456'.
     * @allow (delete) User with ID 'user123' can delete a fitness activity record under their profile.
     * @deny (delete) User with ID 'user123' cannot delete a fitness activity record under the profile of 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/fitnessActivities/{fitnessActivityId} {
      // Only the owner can list their own activities.
      allow list: if isOwner(userId);

      // Only the user can create activity records under their profile.
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;

      // Only the user can read activity records under their profile.
      allow get: if isOwner(userId);

      // Only the user can update activity records under their profile.
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;

      // Only the user can delete activity records under their profile.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/foodLogs/{foodLogId} collection.
     * @path /users/{userId}/foodLogs/{foodLogId}
     * @allow (create) User with ID 'user123' can create a food log record under their profile.
     * @deny (create) User with ID 'user123' cannot create a food log record under the profile of 'user456'.
     * @allow (get) User with ID 'user123' can read a food log record under their profile.
     * @deny (get) User with ID 'user123' cannot read a food log record under the profile of 'user456'.
     * @allow (update) User with ID 'user123' can update a food log record under their profile.
     * @deny (update) User with ID 'user123' cannot update a food log record under the profile of 'user456'.
     * @allow (delete) User with ID 'user123' can delete a food log record under their profile.
     * @deny (delete) User with ID 'user123' cannot delete a food log record under the profile of 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/foodLogs/{foodLogId} {
      // Only the owner can list their own food logs.
      allow list: if isOwner(userId);

      // Only the user can create food log records under their profile.
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;

      // Only the user can read food log records under their profile.
      allow get: if isOwner(userId);

      // Only the user can update food log records under their profile.
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;

      // Only the user can delete food log records under their profile.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/bmiRecords/{bmiRecordId} collection.
     * @path /users/{userId}/bmiRecords/{bmiRecordId}
     * @allow (create) User with ID 'user123' can create a BMI record under their profile.
     * @deny (create) User with ID 'user123' cannot create a BMI record under the profile of 'user456'.
     * @allow (get) User with ID 'user123' can read a BMI record under their profile.
     * @deny (get) User with ID 'user123' cannot read a BMI record under the profile of 'user456'.
     * @allow (update) User with ID 'user123' can update a BMI record under their profile.
     * @deny (update) User with ID 'user123' cannot update a BMI record under the profile of 'user456'.
     * @allow (delete) User with ID 'user123' can delete a BMI record under their profile.
     * @deny (delete) User with ID 'user123' cannot delete a BMI record under the profile of 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/bmiRecords/{bmiRecordId} {
      // Only the owner can list their own BMI records.
      allow list: if isOwner(userId);

      // Only the user can create BMI records under their profile.
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;

      // Only the user can read BMI records under their profile.
      allow get: if isOwner(userId);

      // Only the user can update BMI records under their profile.
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;

      // Only the user can delete BMI records under their profile.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/goals/{goalId} collection.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User with ID 'user123' can create a goal under their profile.
     * @deny (create) User with ID 'user123' cannot create a goal under the profile of 'user456'.
     * @allow (get) User with ID 'user123' can read a goal under their profile.
     * @deny (get) User with ID 'user123' cannot read a goal under the profile of 'user456'.
     * @allow (update) User with ID 'user123' can update a goal under their profile.
     * @deny (update) User with ID 'user123' cannot update a goal under the profile of 'user456'.
     * @allow (delete) User with ID 'user123' can delete a goal under their profile.
     * @deny (delete) User with ID 'user123' cannot delete a goal under the profile of 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
      // Only the owner can list their own goals.
      allow list: if isOwner(userId);

      // Only the user can create goal records under their profile.
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;

      // Only the user can read goal records under their profile.
      allow get: if isOwner(userId);

      // Only the user can update goal records under their profile.
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;

      // Only the user can delete goal records under their profile.
      allow delete: if isExistingOwner(userId);
    }
  }
}